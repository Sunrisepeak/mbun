} // namespace detail

export constexpr Width width(CodePoint codePoint) {
    const auto& table { detail::width_ranges };
    std::size_t low { 0 };
    std::size_t high { table.size() };
    while (low < high) {
        const std::size_t mid { low + (high - low) / 2 };
        if (codePoint < table[mid].lo) {
            high = mid;
        } else if (codePoint > table[mid].hi) {
            low = mid + 1;
        } else {
            return table[mid].width;
        }
    }
    return Width::narrow;
}

// Standalone monospace cell width. Ambiguous-width characters are treated as
// narrow (1), per UAX #11 default recommendation.
export constexpr int wcwidth(CodePoint codePoint) {
    switch (width(codePoint)) {
    case Width::zero: return 0;
    case Width::wide: return 2;
    case Width::narrow:
    case Width::ambiguous: return 1;
    }
    return 1;
}

} // namespace mbun::unicode

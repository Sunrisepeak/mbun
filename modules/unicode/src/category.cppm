} // namespace detail

export constexpr GeneralCategory category(CodePoint codePoint) {
    const auto& table { detail::category_ranges };
    std::size_t low { 0 };
    std::size_t high { table.size() };
    while (low < high) {
        const std::size_t mid { low + (high - low) / 2 };
        if (codePoint < table[mid].lo) {
            high = mid;
        } else if (codePoint > table[mid].hi) {
            low = mid + 1;
        } else {
            return table[mid].category;
        }
    }
    return GeneralCategory::other_not_assigned;
}

} // namespace mbun::unicode

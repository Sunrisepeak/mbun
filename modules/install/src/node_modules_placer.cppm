// node_modules_placer.cppm — mbun.install.node_modules_placer
//
// Stage 3 of nested node_modules: turn the hoister's `{trees,
// hoistedDependencies}` into physical directories.
//
// `plan_placements` is a pure function — hoisted trees in, absolute target
// directories out — so the layout can be asserted against what real bun put on
// disk without touching a filesystem or a socket. `materialize` is the only part
// that does I/O.
//
// Blueprint (ref: .mbun/bun-ref/src/install/):
//   * `Tree::relative_path_and_depth` (lockfile/Tree.rs:310-402) — already
//     ported as `lockfile::tree_relative_path`; a tree's folder name is the
//     *install name* of the edge that created it (`Tree::folder_name`, :91-97),
//     which is why the path is built from `dependencies[tree.dependencyId].name`
//     and not from the package's registry name.
//   * `PackageInstall.rs` — bun installs from its global cache into each tree
//     path by clonefile/hardlink, never by re-downloading. The same PackageID can
//     legitimately appear in several trees (one version needed in several places
//     that could not all hoist), so the tarball is extracted ONCE into a store
//     keyed by PackageID and linked from there per placement. Downloading per
//     placement would refetch the same bytes N times.
//
// The store lives under `node_modules/.mbun-store/<pkgid>` — same filesystem as
// every target, which `std::filesystem::create_hard_link` requires — and is
// removed when the install commits.
export module mbun.install.node_modules_placer;

import std;
import mbun.install.lockfile.decode;
export import mbun.install.lockfile.tree;

namespace mbun::install::node_modules_placer {

namespace lf = mbun::install::lockfile;

// One package landing in one directory. `nodeModules` is the node_modules
// directory it sits directly inside — the `.bin` it links into is that tree's,
// not the root's.
export struct Placement {
    lf::PackageID pkg{lf::INVALID_PACKAGE_ID};
    lf::DependencyID dep{lf::INVALID_DEPENDENCY_ID};
    std::string installName;
    std::filesystem::path nodeModules;
    std::filesystem::path dir;
    std::size_t depth{0};
};

// Split a scoped install name onto its two path components, the way bun lays
// scoped packages out (`node_modules/@scope/name`).
export std::filesystem::path module_dir(const std::filesystem::path& nodeModules,
                                        std::string_view installName) {
    std::filesystem::path out{nodeModules};
    if (installName.starts_with('@')) {
        const std::size_t slash{installName.find('/')};
        if (slash != std::string_view::npos) {
            out /= std::string{installName.substr(0, slash)};
            out /= std::string{installName.substr(slash + 1)};
            return out;
        }
    }
    out /= std::string{installName};
    return out;
}

// Walk the hoisted trees and say where every package goes. Pure: no I/O.
//
// Tree 0 is the root, whose relative path is bare "node_modules"; a deeper tree
// is `node_modules/<a>/node_modules/<b>/node_modules` (Tree.rs:310-402). Each
// tree's `dependencies` window indexes `hoistedDependencies`, and each entry
// there is a dependency ID whose *resolution* is the package to place and whose
// *name* is the folder to place it under.
export std::vector<Placement> plan_placements(const lf::Hoisted& hoisted,
                                              const lf::HoistGraph& graph,
                                              const std::filesystem::path& root) {
    std::vector<Placement> out;
    out.reserve(hoisted.hoistedDependencies.size());
    for (const lf::Tree& tree : hoisted.trees) {
        const lf::TreePath rel{lf::tree_relative_path(hoisted.trees, graph.dependencies, tree.id,
                                                      lf::TreePathStyle::NodeModules)};
        const std::filesystem::path nodeModules{root / rel.path};
        for (std::uint32_t i{tree.dependencies.begin()}; i < tree.dependencies.end(); ++i) {
            if (i >= hoisted.hoistedDependencies.size()) {
                break;
            }
            const lf::DependencyID depId{hoisted.hoistedDependencies[i]};
            if (depId >= graph.dependencies.size()) {
                continue;
            }
            const lf::PackageID pkgId{graph.resolutions[depId]};
            if (pkgId == lf::INVALID_PACKAGE_ID) {
                continue;  // `clean` already drops these, but never trust it twice
            }
            const std::string_view name{graph.dependencies[depId].name};
            out.push_back(Placement{pkgId, depId, std::string{name}, nodeModules,
                                    module_dir(nodeModules, name), rel.depth});
        }
    }
    return out;
}

// ── I/O ─────────────────────────────────────────────────────────────────────

// Recursively hard-link `from` into `to`, falling back to a byte copy when the
// link cannot be made (cross-device, or a filesystem that refuses). bun's
// PackageInstall.rs does the same thing in the same order (clonefile → hardlink
// → copy); we skip clonefile, which is a macOS/btrfs-only fast path.
std::error_code link_tree_(const std::filesystem::path& from, const std::filesystem::path& to) {
    std::error_code ec;
    std::filesystem::create_directories(to, ec);
    if (ec) {
        return ec;
    }
    for (std::filesystem::directory_iterator it{from, ec}, end{}; !ec && it != end;
         it.increment(ec)) {
        const std::filesystem::path dest{to / it->path().filename()};
        std::error_code probe;
        if (it->is_directory(probe) && !it->is_symlink(probe)) {
            if (std::error_code sub{link_tree_(it->path(), dest)}) {
                return sub;
            }
            continue;
        }
        if (it->is_symlink(probe)) {
            const std::filesystem::path target{std::filesystem::read_symlink(it->path(), probe)};
            if (!probe) {
                std::error_code drop;
                std::filesystem::create_symlink(target, dest, drop);
            }
            continue;
        }
        std::error_code linked;
        std::filesystem::create_hard_link(it->path(), dest, linked);
        if (linked) {
            std::error_code copied;
            std::filesystem::copy_file(it->path(), dest,
                                       std::filesystem::copy_options::overwrite_existing, copied);
            if (copied) {
                return copied;
            }
        }
    }
    return ec;
}

// Put the contents of `storeDir` at `dest`, atomically: build a sibling staging
// tree, then rename it into place. The rename is what makes a half-linked
// package unobservable, matching the staging+rename stance the flat installer
// already had.
export std::expected<void, std::string> materialize(const std::filesystem::path& storeDir,
                                                    const std::filesystem::path& dest,
                                                    std::size_t nonce) {
    std::error_code ec;
    std::filesystem::create_directories(dest.parent_path(), ec);
    if (ec) {
        return std::unexpected(
            std::format("failed to create '{}': {}", dest.parent_path().string(), ec.message()));
    }
    const std::filesystem::path staging{dest.parent_path() /
                                        std::format(".{}.mbun-place-{}",
                                                    dest.filename().string(), nonce)};
    std::filesystem::remove_all(staging, ec);
    if (std::error_code linked{link_tree_(storeDir, staging)}) {
        std::filesystem::remove_all(staging, ec);
        return std::unexpected(std::format("failed to link '{}' into '{}': {}", storeDir.string(),
                                           dest.string(), linked.message()));
    }
    std::filesystem::remove_all(dest, ec);
    std::filesystem::rename(staging, dest, ec);
    if (ec) {
        std::error_code drop;
        std::filesystem::remove_all(staging, drop);
        return std::unexpected(
            std::format("failed to commit '{}': {}", dest.string(), ec.message()));
    }
    return {};
}

}  // namespace mbun::install::node_modules_placer
